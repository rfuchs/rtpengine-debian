#!/bin/bash

set -e
set -x

ARCH=$1
shift

SRCDIR=$1
test -d "$SRCDIR"
shift

DSTDIR=$1
test -d "$DSTDIR"
shift

DISTS="$@"
echo "$DISTS"

test -d "$SRCDIR"/"$ARCH" || continue
mkdir -p "$DSTDIR"/"$ARCH"

for DIST in $DISTS; do
	test -d "$SRCDIR"/"$ARCH"/"$DIST" || continue
	DD="$DSTDIR"/"$ARCH"/"$DIST"
	mkdir -p "$DD"

	for FILE in "$SRCDIR"/"$ARCH"/"$DIST"/*; do
		test -e "$FILE" || continue
		BN=$(basename "$FILE")
		test -e "$DD"/"$BN" && continue
		mv -v "$FILE" "$DD"/."$BN".$$
		mv -v "$DD"/."$BN".$$ "$DD"/"$BN"
	done
done
